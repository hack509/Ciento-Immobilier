# =============================================================================
# Ciento-Immobilier — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Supabase (Required) ---
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Application (Optional) ---
# Used for URL generation in emails and SEO meta tags
VITE_APP_URL=https://ciento-immobilier.vercel.app
# Application display name
VITE_APP_NAME=Ciento-Immobilier


# =============================================================================
# Payments Edge Function — SERVER-SIDE SECRETS (never prefix with VITE_)
# Set them with:  supabase secrets set NAME=value
# =============================================================================
# APP_ENV=production                 # production | staging | development
# PAYMENTS_MODE=live                 # live | simulation (simulation is refused when APP_ENV=production)
# ALLOWED_ORIGINS=https://ciento-immobilier.com
# MONCASH_CLIENT_ID=                 # Digicel MonCash merchant credentials
# MONCASH_CLIENT_SECRET=
# MONCASH_MODE=sandbox               # sandbox | live
# PAYMENT_MANUAL_INSTRUCTIONS="Virement Unibank n° ... — indiquez la référence"
# MonCash return URL (merchant portal): <VITE_APP_URL>/dashboard/paiement/retour

# =============================================================================
# SEO & analytics (front-end, public values — optional)
# =============================================================================
# VITE_APP_URL must be the final public domain: canonical URLs, sitemap and robots.txt use it.
# VITE_GOOGLE_SITE_VERIFICATION=   # Search Console "balise HTML" token (content="…")
# VITE_BING_SITE_VERIFICATION=     # Bing Webmaster Tools msvalidate.01 token
# VITE_GA_MEASUREMENT_ID=          # Google Analytics 4, format G-XXXXXXXXXX (no tag loaded if empty)
# VITE_FACEBOOK_URL=               # Social links shown in the footer / Organization JSON-LD
# VITE_INSTAGRAM_URL=

# =============================================================================
# E-mail Edge Functions — SERVER-SIDE SECRETS (supabase secrets set …)
# Without a provider nothing is sent and the admin UI says so explicitly.
# =============================================================================
# EMAIL_PROVIDER=resend            # resend | brevo
# RESEND_API_KEY=                  # or BREVO_API_KEY=
# EMAIL_FROM=newsletter@ciento-immobilier.com   # verified sender domain
# EMAIL_FROM_NAME=CIENTO-IMMOBILIER
# EMAIL_REPLY_TO=contact@cientoimmobilier.com
# SITE_URL=https://ciento-immobilier.com
# ADMIN_NOTIFICATION_EMAIL=        # receives an alert for each new contact message
# CONTACT_WEBHOOK_SECRET=          # shared secret of the contact_messages Database Webhook
# RESEND_WEBHOOK_SECRET=whsec_…    # delivery/open/click/bounce statistics (Resend)
# BREVO_WEBHOOK_SECRET=            # same for Brevo (?provider=brevo&secret=…)
# NEWSLETTER_FROM_EMAIL / RESEND_API_KEY are still read by newsletter-subscribe (existing)
