# =============================================================================
# Ciento-Immobilier — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Supabase (Required) ---
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Application (Optional) ---
# Used for URL generation in emails and SEO meta tags
VITE_APP_URL=https://ciento-immobilier.vercel.app
# Application display name
VITE_APP_NAME=Ciento-Immobilier

# --- Gemini AI Chat (Required for ChatBot) ---
# Proxy URL for the Supabase Edge Function that relays to Gemini API
VITE_GEMINI_PROXY_URL=/api/gemini-proxy
# NOTE: The actual Gemini API key is set as a Supabase Edge Function secret:
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
